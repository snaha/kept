{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "audit:serve": "pnpm build && node tests/agent/server.mjs",
    "audit:test": "node --test tests/agent/*.test.mjs",
    "audit:regressions": "node tests/agent/run.mjs",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@vitest/browser-playwright": "^4.1.11",
    "agent-browser": "0.5.0",
    "playwright": "^1.63.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vitest-browser-svelte": "^2.2.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "bits-ui": "^2.19.3",
    "butterchurn": "3.0.0-beta.5",
    "butterchurn-presets": "2.4.7",
    "clsx": "^2.1.1",
    "qrcode": "^1.5.4",
    "subsonic-api": "^3.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js"
    ]
  }
}
