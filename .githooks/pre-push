#!/bin/sh
# Check what each push publishes: see AGENTS.md, Private music.
[ -f scripts/check-private-data.mjs ] || exit 0
remote=$1
status=0
while read -r local_ref local_sha _remote_ref remote_sha; do
  [ "$local_ref" = '(delete)' ] && continue
  case "$remote_sha" in
    *[!0]*)
      if git rev-parse --verify --quiet "$remote_sha^{commit}" >/dev/null; then
        node scripts/check-private-data.mjs --range "$remote_sha...$local_sha" || status=1
      else
        node scripts/check-private-data.mjs --ref "$local_sha" || status=1
      fi
      ;;
    *) node scripts/check-private-data.mjs --ref "$local_sha" --exclude-remote "$remote" || status=1 ;;
  esac
done
exit $status
