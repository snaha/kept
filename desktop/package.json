{
  "name": "kept-desktop",
  "productName": "Kept",
  "version": "0.7.0",
  "private": true,
  "description": "Navidrome and the music frontend packaged as one desktop app",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "navidrome": "node scripts/fetch-navidrome.mjs",
    "build:frontend": "cd ../frontend && pnpm build --outDir ../desktop/dist --emptyOutDir",
    "build:preload": "node scripts/build-preload.mjs",
    "test": "node --test contracts.test.js music-store.test.js history.test.js player.test.js music-folders.test.js track-paths.test.js sign-mac.test.js mac-distribution.test.js portable-linux.test.js service-lifecycle.test.js main.test.js assistant.test.js profiles.test.js catalog-contracts.test.js catalog-bridge.test.js tool-contracts.test.js tool-runner.test.js catalog-store.test.js catalog-ingest.test.js job-queue.test.js resource-policy.test.js library-worker.test.js feature-store.test.js analysis.test.js estimated-traits.test.js reconstruct.test.js reconstruct-jobs.test.js reconstruct-corpus.test.js && node --experimental-strip-types --test ../frontend/tests/*.test.ts",
    "dev": "pnpm build:preload && pnpm build:frontend && electron .",
    "dev:hot": "pnpm build:preload && sh -c 'trap \"kill 0\" EXIT; (cd ../frontend && MUSIC_HMR_PORT=5183 exec pnpm exec vite --host 127.0.0.1 --port 5183 --strictPort) & MUSIC_DEV_SERVER=http://127.0.0.1:5183 electron .'",
    "prepare:build": "node scripts/prepare-build.mjs",
    "dist": "pnpm validate && pnpm dist:package",
    "dist:mac": "pnpm validate && pnpm dist:mac:package",
    "pack:mac:dir": "pnpm prepare:build && pnpm build:preload && node scripts/package-mac.mjs --dir",
    "pack:mac": "node scripts/package-mac.mjs",
    "pack:portable": "node scripts/package-portable.mjs",
    "dev:app": "pnpm validate && node scripts/repo-app.mjs",
    "validate": "node ../frontend/tests/validate.mjs",
    "test:integration": "node --test tests/sharing-integration.test.mjs",
    "dist:package": "pnpm prepare:build && pnpm navidrome && pnpm ffmpeg && pnpm models --strict && pnpm build:preload && pnpm build:frontend && electron-builder --config builder-config.json --linux --publish never && pnpm pack:portable",
    "dist:mac:package": "node scripts/check-mac-distribution.mjs && pnpm navidrome && pnpm ffmpeg && pnpm models --strict && pnpm build:frontend && pnpm pack:mac:dir && pnpm pack:mac && pnpm pack:portable",
    "dev:app:quick": "pnpm navidrome && pnpm ffmpeg && pnpm models && pnpm build:preload && pnpm build:frontend && node scripts/repo-app.mjs",
    "ffmpeg": "node scripts/build-ffmpeg.mjs",
    "models": "node scripts/fetch-openl3.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "onnxruntime-web": "1.20.1"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "dev.musicapp.desktop",
    "asar": false,
    "files": [
      "package.json",
      "main.js",
      "profiles.js",
      "music-folders.js",
      "track-paths.js",
      "storage-migration.js",
      "service-lifecycle.js",
      "build-info.json",
      "music-database.js",
      "music-store-worker.js",
      "music-store.js",
      "worker-client.js",
      "audio-payload.js",
      "job-queue.js",
      "resource-policy.js",
      "library-worker.js",
      "library-process.js",
      "library-process-child.js",
      "library-job-classes.js",
      "library-service.js",
      "hash-jobs.js",
      "reconstruct-jobs.js",
      "reconstruct-store.js",
      "musicbrainz.js",
      "embedded-tags.js",
      "tagsmith-read.js",
      "analysis-jobs.js",
      "analysis/*.js",
      "feature-source.js",
      "estimated-traits.js",
      "feature-store.js",
      "feature-store-worker.js",
      "feature-database.js",
      "jobs/*.js",
      "catalog-store.js",
      "catalog-store-worker.js",
      "catalog-database.js",
      "catalog-ingest.js",
      "tool-services.js",
      "assistant.js",
      "assistant-constraints.js",
      "assistant-providers.js",
      "assistant-privacy.js",
      "assistant-service.js",
      "assistant-settings.js",
      "preload.bundle.cjs",
      "dist/**/*",
      "!node_modules/onnxruntime-web/dist/**",
      "node_modules/onnxruntime-web/dist/ort.node.min.mjs",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm"
    ],
    "extraResources": [
      {
        "from": "bin/navidrome",
        "to": "navidrome"
      },
      {
        "from": "bin/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "bin/ffmpeg.LGPL-2.1.txt",
        "to": "ffmpeg.LGPL-2.1.txt"
      },
      {
        "from": "models",
        "to": "models",
        "filter": [
          "*.onnx",
          "*.f32",
          "*.json"
        ]
      },
      {
        "from": "../shared",
        "to": "shared",
        "filter": [
          "contracts.js",
          "catalog-rules.js",
          "catalog-bridge.js",
          "catalog-ledger.js",
          "catalog-projection.js",
          "tool-contracts.js",
          "tool-runner.js",
          "tool-support.js",
          "source-policy.js",
          "reconstruct.js",
          "reconstruct-match.js",
          "package.json"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "maintainer": "Attila Gazso <agazso@gmail.com>"
    },
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "darkModeSupport": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "homepage": "https://github.com/snaha/kept",
  "author": "Attila Gazso <agazso@gmail.com>"
}
