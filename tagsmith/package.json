{
  "name": "tagsmith",
  "version": "0.1.0",
  "private": true,
  "description": "Index a music library and plan tag fixes as a dry run; apply tags to a verified copy",
  "type": "module",
  "bin": {
    "tagsmith": "src/cli.ts"
  },
  "scripts": {
    "tagsmith": "node src/cli.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:library": "scripts/test-library.sh"
  },
  "dependencies": {
    "music-metadata": "^11.9.0",
    "node-taglib-sharp": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "main": "dist/read.js",
  "types": "dist/read.d.ts",
  "exports": {
    ".": {
      "types": "./dist/read.d.ts",
      "default": "./dist/read.js"
    }
  }
}
